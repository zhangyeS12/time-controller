<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBackground">#F5F7FB</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorSurfaceSoft">#FFF8FAFC</Color>
    <Color x:Key="ColorPrimary">#FF4F46E5</Color>
    <Color x:Key="ColorPrimaryHover">#FF4338CA</Color>
    <Color x:Key="ColorPrimarySoft">#FFEDEBFE</Color>
    <Color x:Key="ColorText">#FF111827</Color>
    <Color x:Key="ColorMuted">#FF64748B</Color>
    <Color x:Key="ColorLine">#FFE2E8F0</Color>
    <Color x:Key="ColorDanger">#FFDC2626</Color>
    <Color x:Key="ColorDangerSoft">#FFFEE2E2</Color>
    <Color x:Key="ColorSuccess">#FF059669</Color>
    <Color x:Key="ColorWarning">#FFD97706</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceSoft" Color="{StaticResource ColorSurfaceSoft}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimarySoft" Color="{StaticResource ColorPrimarySoft}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="BrushLine" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerSoft" Color="{StaticResource ColorDangerSoft}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
</ResourceDictionary>
