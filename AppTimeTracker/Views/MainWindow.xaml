                                                    <Button Content="缂栬緫" Command="{Binding DataContext.EditFocusRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" />
                                                    <Button Content="删除" Command="{Binding DataContext.DeleteFocusRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="12,8" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
