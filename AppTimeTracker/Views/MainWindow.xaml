                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="规则列表" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="最多使用规则超过每日限制后，每条规则每天只提醒一次" Style="{StaticResource SectionSubtitle}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FocusRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="14" Padding="16" Margin="0,0,0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushSurfaceSoft}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverLimit}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" MinWidth="210" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushText}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TargetDisplayName}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding TargetTypeText}" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                                    <TextBlock Text="{Binding RuleTypeText}" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="每日目标" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                                    <TextBlock Text="{Binding LimitText}" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="今日已用" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                                    <TextBlock Text="{Binding TodayUsageText}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="{Binding StateText}" Foreground="{StaticResource BrushMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="10" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}" Background="{StaticResource BrushPrimarySoft}" BorderThickness="0" />
                                                </StackPanel>
