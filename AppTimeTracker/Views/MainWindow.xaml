                        <StackPanel>
                            <TextBlock Text="最常用应用" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportTopApp}" ToolTip="{Binding ReportTopApp}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="最常用分类" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportTopCategory}" ToolTip="{Binding ReportTopCategory}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                        <StackPanel>
                            <TextBlock Text="使用应用数量" Style="{StaticResource MetricLabel}" />
