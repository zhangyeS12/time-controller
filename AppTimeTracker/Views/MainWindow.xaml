<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AppTimeTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppTimeTracker.ViewModels"
        Title="time-controller"
        Icon="/Assets/time-controller.ico"
        Width="1440"
        Height="900"
        MinWidth="1260"
        MinHeight="780"
        Background="{StaticResource BrushBackground}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,8,0,36">
                    <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource BrushPrimary}" HorizontalAlignment="Left">
                        <TextBlock Text="AT" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="time-controller" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,14,0,2" />
                    <TextBlock Text="本地应用时间看板" Foreground="#94A3B8" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button x:Name="DashboardNavButton" Content="仪表盘" Style="{StaticResource SidebarButtonActive}" Click="DashboardNavButton_Click" />
                    <Button x:Name="HistoryNavButton" Content="历史统计" Style="{StaticResource SidebarButton}" Click="HistoryNavButton_Click" />
                    <Button x:Name="AppsNavButton" Content="应用管理" Style="{StaticResource SidebarButton}" Click="AppsNavButton_Click" />
                    <Button x:Name="RulesNavButton" Content="专注规则" Style="{StaticResource SidebarButton}" Click="RulesNavButton_Click" />
                    <Button x:Name="FocusSessionNavButton" Content="专注会话" Style="{StaticResource SidebarButton}" Click="FocusSessionNavButton_Click" />
                    <Button x:Name="ReportsNavButton" Content="报告分析" Style="{StaticResource SidebarButton}" Click="ReportsNavButton_Click" />
                    <Button x:Name="DataNavButton" Content="数据设置" Style="{StaticResource SidebarButton}" Click="DataNavButton_Click" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="v1.11.0" Foreground="#64748B" FontSize="12" Margin="16,0,0,8" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32">
            <Grid x:Name="DashboardPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="118" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="应用使用统计" Foreground="{StaticResource BrushText}" FontSize="32" FontWeight="Bold" />
                        <TextBlock Text="记录你的应用使用时间，帮助你了解每天的时间流向" Foreground="{StaticResource BrushMuted}" FontSize="14" Margin="2,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushPrimarySoft}" CornerRadius="999" Padding="14,8" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushPrimary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,18">
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="今日总使用时长" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding TodayTotalTime}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="今日最常用应用" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding TodayTopApp}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="当前正在统计" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding CurrentApp}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="当前应用已持续" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding CurrentDuration}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="16,0,0,0">
                        <StackPanel>
                            <TextBlock Text="今日专注" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding TodayFocusTotalTime}" Style="{StaticResource MetricValue}" />
                            <TextBlock Text="{Binding TodayFocusCompletedCount, StringFormat=完成 {0} 次}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="今日应用排行榜" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="今日使用更醒目，累计使用来自 SQLite 全部历史记录" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Ranking}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushSurfaceSoft}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" MinWidth="120" />
                                                        <ColumnDefinition Width="230" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BrushPrimarySoft}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Rank}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="6,0,14,0">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource BrushText}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                            <TextBlock Text="今日" Foreground="{StaticResource BrushMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding TodayDurationText}" Foreground="{StaticResource BrushPrimary}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="累计" Foreground="{StaticResource BrushMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding TotalDurationText}" Foreground="{StaticResource BrushMuted}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="今日时间轴" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="小于 3 秒的短记录默认隐藏" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Timeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Border Width="2" Background="{StaticResource BrushLine}" HorizontalAlignment="Center" Margin="0,4,0,-12" />
                                                    <Ellipse Width="11" Height="11" Fill="{StaticResource BrushPrimary}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" />
                                                </Grid>
                                                <Border Grid.Column="1" Background="{StaticResource BrushSurfaceSoft}" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TimeRange}" Foreground="{StaticResource BrushMuted}" FontSize="12" />
                                                        <TextBlock Grid.Row="1" Text="{Binding AppName}" Foreground="{StaticResource BrushText}" FontWeight="Bold" FontSize="15" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding DurationText}" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="空闲阈值" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DockPanel>
                                <TextBox Text="{Binding IdleThresholdSeconds, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <TextBlock Text="秒后暂停统计" Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="后台运行" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <UniformGrid Columns="2" Rows="2">
                                <CheckBox Content="记录窗口标题" IsChecked="{Binding RecordWindowTitle}" Margin="0,0,12,10" />
                                <CheckBox Content="手动暂停统计" IsChecked="{Binding ManualPaused}" Margin="0,0,0,10" />
                                <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart}" Margin="0,0,12,0" />
                                <CheckBox Content="关闭隐藏到托盘" IsChecked="{Binding CloseToTray}" />
                            </UniformGrid>
                            <CheckBox Content="启动后隐藏到托盘" IsChecked="{Binding StartMinimizedToTray}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="清空今日数据" Command="{Binding ClearTodayCommand}" Style="{StaticResource DangerButton}" Margin="0,0,12,0" />
                                <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                                <Button Content="立即隐藏到托盘" Command="{Binding HideToTrayCommand}" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DatabasePath, StringFormat=数据库：{0}}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="HistoryPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="118" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="历史统计" Foreground="{StaticResource BrushText}" FontSize="32" FontWeight="Bold" />
                        <TextBlock Text="按应用维度查看今日、近7天、近30天和累计使用时长" Foreground="{StaticResource BrushMuted}" FontSize="14" Margin="2,7,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushPrimarySoft}" CornerRadius="999" Padding="14,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding HistoryRangeTitle}" Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="今天" Command="{Binding SetHistoryRangeCommand}" CommandParameter="Today" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="最近7天" Command="{Binding SetHistoryRangeCommand}" CommandParameter="Last7Days" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="最近30天" Command="{Binding SetHistoryRangeCommand}" CommandParameter="Last30Days" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="全部历史" Command="{Binding SetHistoryRangeCommand}" CommandParameter="All" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="范围总使用时长" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding HistoryTotalTime}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="范围最常用应用" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding HistoryTopApp}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="平均每日使用" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding HistoryAverageDaily}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="使用应用数量" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding HistoryAppCount}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.22*" />
                        <ColumnDefinition Width="0.78*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="应用多时间范围统计" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="默认按最近7天使用时长排序，忽略应用不会显示" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding HistoryRanking}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushSurfaceSoft}" CornerRadius="14" Padding="14" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" MinWidth="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource BrushPrimarySoft}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Rank}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="6,0,14,0">
                                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" Foreground="{StaticResource BrushText}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProcessName}" ToolTip="{Binding ProcessName}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock Text="今日" Foreground="{StaticResource BrushMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding TodayDurationText}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" TextWrapping="NoWrap" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                        <TextBlock Text="近7天" Foreground="{StaticResource BrushMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding Last7DaysDurationText}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" TextWrapping="NoWrap" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                                                        <TextBlock Text="近30天" Foreground="{StaticResource BrushMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding Last30DaysDurationText}" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" TextWrapping="NoWrap" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="5" HorizontalAlignment="Right">
                                                        <TextBlock Text="累计" Foreground="{StaticResource BrushMuted}" FontSize="11" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding TotalDurationText}" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" TextWrapping="NoWrap" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.05*" />
                            <RowDefinition Height="0.95*" />
                            <RowDefinition Height="0.95*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding HistoryTrendTitle}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="最近7天或最近30天的每日总使用时长" Style="{StaticResource SectionSubtitle}" />
                                </StackPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding DailyTrend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="3,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Width="16" MinHeight="4" CornerRadius="8" Background="{StaticResource BrushPrimary}" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border.Height>
                                                        <Binding Path="Percent" />
                                                    </Border.Height>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding DateText}" Foreground="{StaticResource BrushMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <TextBlock Grid.Row="2" Text="{Binding DurationText}" Foreground="{StaticResource BrushText}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="应用使用占比" Style="{StaticResource SectionTitle}" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding HistoryAppShare}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PercentageText}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Margin="12,0,0,0" />
                                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Percentage}" Height="9" Foreground="{StaticResource BrushPrimary}" Background="{StaticResource BrushPrimarySoft}" BorderThickness="0" Margin="0,6,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="分类使用占比" Style="{StaticResource SectionTitle}" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding HistoryCategoryShare}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource BrushText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="10,0,0,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PercentageText}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" Margin="10,0,0,0" />
                                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="100" Value="{Binding Percentage}" Height="9" Foreground="{StaticResource BrushPrimary}" Background="{StaticResource BrushPrimarySoft}" BorderThickness="0" Margin="0,6,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

