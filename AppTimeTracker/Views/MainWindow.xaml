                            <TextBlock Text="{Binding FocusNotificationCount}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="今日已超时规则" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FocusOverLimitCount}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="今日已完成目标" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FocusCompletedCount}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="今日专注状态" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FocusTodayState}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
