                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前状态" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding FocusSessionStatus}" Foreground="{StaticResource BrushPrimary}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding FocusSessionCurrentName}" Foreground="{StaticResource BrushMuted}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="&#x5269;&#x4F59;&#x65F6;&#x95F4;" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FocusSessionRemaining}" Foreground="{StaticResource BrushText}" FontSize="42" FontWeight="Bold" Margin="0,8,0,0" />
                        </StackPanel>
                        <UniformGrid Grid.Column="2" Columns="1" Rows="3">
                            <StackPanel>
                                <TextBlock Text="&#x5DF2;&#x4E13;&#x6CE8;" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding FocusSessionActual}" Foreground="{StaticResource BrushText}" FontWeight="Bold" FontSize="18" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="分心次数" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding FocusSessionDistractions}" Foreground="{StaticResource BrushWarning}" FontWeight="Bold" FontSize="18" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="当前应用" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding CurrentApp}" Foreground="{StaticResource BrushText}" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="快捷模式" Style="{StaticResource SectionTitle}" />
                            <Button Content="25 分钟专注" Command="{Binding StartQuickFocusCommand}" CommandParameter="25" Margin="0,18,0,10" />
                            <Button Content="45 分钟深度专注" Command="{Binding StartQuickFocusCommand}" CommandParameter="45" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" />
                            <Button Content="60 分钟学习" Command="{Binding StartQuickFocusCommand}" CommandParameter="60" Style="{StaticResource SecondaryButton}" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Content="&#x6682;&#x505C;" Command="{Binding PauseFocusSessionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button Content="&#x7EE7;&#x7EED;" Command="{Binding ResumeFocusSessionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button Content="&#x7ED3;&#x675F;" Command="{Binding EndFocusSessionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button Content="&#x653E;&#x5F03;" Command="{Binding AbandonFocusSessionCommand}" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
