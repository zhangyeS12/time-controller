                        <StackPanel>
                            <TextBlock Text="超时规则触发" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportRuleNotificationCount}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="专注完成次数" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportFocusCompletedCount}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="专注总时长" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportFocusTotalTime}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="平均单次专注" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportFocusAverageTime}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Text="分心总次数" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportFocusDistractionCount}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" MinHeight="260" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top 应用" Style="{StaticResource SectionTitle}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                                <ItemsControl ItemsSource="{Binding ReportTopApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="42" Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" Foreground="{StaticResource BrushText}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProcessName}" ToolTip="{Binding ProcessName}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding PercentageText}" Foreground="{StaticResource BrushMuted}" FontSize="12" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Percentage}" Height="9" Foreground="{StaticResource BrushPrimary}" Background="{StaticResource BrushPrimarySoft}" BorderThickness="0" Margin="0,8,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" MinHeight="260">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top 分类" Style="{StaticResource SectionTitle}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                                <ItemsControl ItemsSource="{Binding ReportTopCategories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="42" Margin="0,0,0,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" Foreground="{StaticResource BrushText}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding PercentageText}" Foreground="{StaticResource BrushMuted}" FontSize="12" HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding Percentage}" Height="9" Foreground="{StaticResource BrushPrimary}" Background="{StaticResource BrushPrimarySoft}" BorderThickness="0" Margin="0,8,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" MinHeight="320" Margin="0,18,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="每日趋势" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="当前报告范围内每天的总使用时长" Style="{StaticResource SectionSubtitle}" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" MinHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ReportDailyTrend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="64" MinHeight="228" Margin="0,0,10,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Width="26" MinHeight="4" CornerRadius="13" Background="{StaticResource BrushPrimary}" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                    <Border.Height>
                                                        <Binding Path="Percent" />
                                                    </Border.Height>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding DateText}" Foreground="{StaticResource BrushMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                                <TextBlock Grid.Row="2" Text="{Binding DurationText}" ToolTip="{Binding DurationText}" Foreground="{StaticResource BrushText}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="62" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" MinHeight="180">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="文字总结" Style="{StaticResource SectionTitle}" />
                        <TextBlock Grid.Row="1"
                                   Text="{Binding ReportSummaryText}"
                                   Foreground="{StaticResource BrushText}"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </Grid>
                </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="DataSettingsPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="数据设置" Foreground="{StaticResource BrushText}" FontSize="32" FontWeight="Bold" />
                            <TextBlock Text="{Binding DataStatusText}" Foreground="{StaticResource BrushMuted}" FontSize="14" Margin="2,7,0,0" />
                        </StackPanel>

                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,18">
                            <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><TextBlock Text="数据库大小" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding DatabaseFileSize}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><TextBlock Text="使用记录数量" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding DatabaseSessionCount}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="应用数量" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding DatabaseAppCount}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="最早记录" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding DatabaseEarliestRecord}" Style="{StaticResource MetricValue}" FontSize="18" LineHeight="26" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="最新记录" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding DatabaseLatestRecord}" Style="{StaticResource MetricValue}" FontSize="18" LineHeight="26" /></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="数据库路径" Style="{StaticResource MetricLabel}" /><TextBlock Text="{Binding DatabasePath}" ToolTip="{Binding DatabasePath}" Foreground="{StaticResource BrushText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" /></StackPanel></Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" MinHeight="250"><StackPanel><TextBlock Text="导出数据" Style="{StaticResource SectionTitle}" /><Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" Margin="0,18,0,10" /><Button Content="导出 JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" /><Button Content="导出报告摘要 TXT" Command="{Binding ExportReportTextCommand}" Style="{StaticResource SecondaryButton}" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0" MinHeight="250"><StackPanel><TextBlock Text="清理数据" Style="{StaticResource SectionTitle}" /><Button Content="清空今日数据" Command="{Binding ClearTodayCommand}" Style="{StaticResource DangerButton}" Margin="0,18,0,10" /><Button Content="清空全部数据" Command="{Binding ClearAllDataCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,10" /><Button Content="删除 30 天前记录" Command="{Binding DeleteDataBefore30DaysCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" /><Button Content="删除 90 天前记录" Command="{Binding DeleteDataBefore90DaysCommand}" Style="{StaticResource SecondaryButton}" /></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="250"><StackPanel><TextBlock Text="数据库维护" Style="{StaticResource SectionTitle}" /><Button Content="刷新数据库信息" Command="{Binding RefreshDatabaseInfoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,18,0,10" /><Button Content="压缩数据库 VACUUM" Command="{Binding VacuumDatabaseCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" /><Button Content="重建索引" Command="{Binding RebuildIndexesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" /><Button Content="数据健康检查" Command="{Binding HealthCheckCommand}" /></StackPanel></Border>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" MinHeight="330">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="备份与恢复" Style="{StaticResource SectionTitle}" /><Button Grid.Column="1" Content="打开备份目录" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8" /></Grid>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,12"><Button Content="立即创建备份" Command="{Binding CreateBackupCommand}" Margin="0,0,10,0" /><CheckBox Content="每日自动备份" IsChecked="{Binding AutoDailyBackupEnabled}" Margin="0,0,14,0" VerticalAlignment="Center" /><CheckBox Content="退出时备份" IsChecked="{Binding BackupOnExitEnabled}" VerticalAlignment="Center" /></StackPanel>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Backups}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F8FAFC" CornerRadius="12" Padding="12" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" ToolTip="{Binding FullPath}" Foreground="{StaticResource BrushText}" FontWeight="Bold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding TypeText}" Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,4,0,0" /><TextBlock Text="{Binding CreatedAtText}" Foreground="{StaticResource BrushMuted}" FontSize="12" /></StackPanel><Button Grid.Column="1" Content="恢复" Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,8" Margin="8,0,0,0" /><Button Grid.Column="2" Content="删除" Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="10,8" Margin="8,0,0,0" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" MinHeight="330"><StackPanel><TextBlock Text="时间与时区" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding SystemTimeZoneDisplayName, StringFormat=系统时区：{0}}" Foreground="{StaticResource BrushMuted}" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedTimeZoneDisplayName, StringFormat=当前使用：{0}}" Foreground="{StaticResource BrushMuted}" FontSize="13" Margin="0,8,0,12" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding TimeZoneOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedTimeZoneId}" Height="40" /><Button Content="保存时区设置" Command="{Binding SaveTimeZoneCommand}" Margin="0,12,0,0" /><TextBlock Text="统计日期会按这里选择的时区计算。旧版本本地时间数据会继续兼容读取。" Foreground="{StaticResource BrushMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" /></StackPanel></Border>
                        </Grid>

                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" MinHeight="180"><StackPanel><TextBlock Text="健康检查结果" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding DataHealthCheckResult}" Foreground="{StaticResource BrushText}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" MinHeight="180"><StackPanel><TextBlock Text="关于 time-controller" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding AppVersion, StringFormat=当前版本：{0}}" Foreground="{StaticResource BrushMuted}" Margin="0,10,0,0" /><TextBlock Text="{Binding DataDirectory, StringFormat=数据目录：{0}}" ToolTip="{Binding DataDirectory}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" /><TextBlock Text="{Binding DatabasePath, StringFormat=数据库：{0}}" ToolTip="{Binding DatabasePath}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" /><TextBlock Text="{Binding LogDirectory, StringFormat=日志目录：{0}}" ToolTip="{Binding LogDirectory}" Foreground="{StaticResource BrushMuted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" /><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="数据目录" Command="{Binding OpenDataDirectoryCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" /><Button Content="日志目录" Command="{Binding OpenLogDirectoryCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0" /><Button Content="导出目录" Command="{Binding OpenExportDirectoryCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8" /></StackPanel></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="PlaceholderPage" Visibility="Collapsed" Style="{StaticResource Card}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="PlaceholderTitle" Text="功能规划中" Foreground="{StaticResource BrushText}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="这个页面会在后续版本中实现。" Foreground="{StaticResource BrushMuted}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="ToastHost"
                Grid.ColumnSpan="2"
                Width="360"
                Background="{StaticResource BrushText}"
                CornerRadius="14"
                Padding="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,26,28,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ToastTitle" Foreground="White" FontWeight="Bold" FontSize="14" />
                <TextBlock x:Name="ToastMessage" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
