                            <TextBlock Text="平均每日使用" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReportAverageDaily}" Style="{StaticResource MetricValue}" FontSize="20" LineHeight="28" />
                        </StackPanel>
                    </Border>
