                        <TextBlock Text="{Binding FocusFormTitle}" Style="{StaticResource SectionTitle}" />
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="规则名称" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBox Text="{Binding FocusRuleName, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox Content="启用" IsChecked="{Binding FocusRuleEnabled}" Margin="0,0,18,0" />
                                    <CheckBox Content="弹窗提醒" IsChecked="{Binding FocusNotifyEnabled}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Text="对象类型" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding FocusTargetTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FocusTargetType}" Height="40" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                <TextBlock Text="选择应用" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding ManagedApps}" DisplayMemberPath="DisplayName" SelectedValuePath="ProcessName" SelectedValue="{Binding FocusAppProcessName}" Height="40" />
                                <TextBlock Text="对象类型为应用时生效" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,14,0">
                                <TextBlock Text="选择分类" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding FocusCategory}" Height="40" />
                                <TextBlock Text="对象类型为分类时生效" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,14,0">
                                <TextBlock Text="规则类型" Foreground="{StaticResource BrushMuted}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding FocusRuleTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FocusRuleType}" Height="40" />
                                <TextBox Text="{Binding FocusLimitMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" />
                                <TextBlock Text="分钟/天" Foreground="{StaticResource BrushMuted}" FontSize="11" Margin="4,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="保存规则" Command="{Binding SaveFocusRuleCommand}" Margin="0,0,0,10" />
                                <Button Content="閲嶇疆琛ㄥ崟" Command="{Binding ResetFocusRuleFormCommand}" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="FocusSessionPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="170" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="170" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="专注会话" Foreground="{StaticResource BrushText}" FontSize="32" FontWeight="Bold" />
