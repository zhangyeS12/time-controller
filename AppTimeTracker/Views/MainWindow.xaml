                            <TextBlock Text="&#x81EA;&#x5B9A;&#x4E49;&#x4E13;&#x6CE8;" Style="{StaticResource SectionTitle}" />
                            <Grid Grid.Row="1" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="会话名称" Style="{StaticResource MetricLabel}" />
                                    <TextBox Text="{Binding FocusSessionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" />
                                    <CheckBox Content="允许浏览器" IsChecked="{Binding FocusSessionAllowBrowser}" Margin="0,0,0,8" />
                                    <CheckBox Content="&#x5141;&#x8BB8;&#x7CFB;&#x7EDF;&#x5DE5;&#x5177;" IsChecked="{Binding FocusSessionAllowSystemTools}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="分钟" Style="{StaticResource MetricLabel}" />
                                    <TextBox Text="{Binding FocusSessionMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,12" />
                                    <CheckBox Content="分心提醒" IsChecked="{Binding FocusSessionNotifyEnabled}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="目标类型" Style="{StaticResource MetricLabel}" />
                                    <ComboBox ItemsSource="{Binding FocusTargetTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FocusSessionTargetType}" Height="40" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="目标应用/分类" Style="{StaticResource MetricLabel}" />
                                    <ComboBox ItemsSource="{Binding ManagedApps}" DisplayMemberPath="DisplayName" SelectedValuePath="ProcessName" SelectedValue="{Binding FocusSessionAppProcessName}" Height="40" Margin="0,8,0,8" />
                                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding FocusSessionCategory}" Height="40" />
                                    <Button Content="开始" Command="{Binding StartFocusSessionCommand}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}">
